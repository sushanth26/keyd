# ---------------------------------------------------------------------------
# Keyd environment configuration. Copy to `.env` and adjust for your machine.
# NEVER commit a real .env — it is gitignored. Do not put secrets in .env.example.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) ---
# Docker Compose users: postgresql://keyd:keyd@localhost:5432/keyd?schema=public
# Local Postgres (macOS/Homebrew, trust auth): postgresql://<youruser>@localhost:5432/keyd_dev
DATABASE_URL="postgresql://keyd:keyd@localhost:5432/keyd?schema=public"

# --- Auth ---
# 32+ char random secret used to sign session JWTs. Generate: openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me-please-0123456789abcdef"
# Cookie name for the session token.
SESSION_COOKIE="keyd_session"

# --- App ---
NODE_ENV="development"
APP_URL="http://localhost:3000"
APP_NAME="Keyd"

# --- Providers (all default to local/mock drivers for the MVP) ---
# ai: "mock" (deterministic template generator, no external calls)
AI_PROVIDER="mock"
# email: "outbox" writes .json files to storage/outbox; "console" logs to stdout
EMAIL_PROVIDER="outbox"
EMAIL_FROM="Keyd <no-reply@keyd.local>"
# identity/ownership verification: "manual" (admin review) or "mock-auto" (auto-approves in dev)
VERIFICATION_PROVIDER="manual"
# property data enrichment: "seed" uses seeded/mock DFW comparables data
ENRICHMENT_PROVIDER="seed"
# object storage: "local" writes under ./storage
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT="./storage"

# --- SEO ---
# Absolute production origin (no trailing slash). Used for canonical/OG/sitemap URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Google Search Console verification token (the content of the meta-tag method). Optional.
NEXT_PUBLIC_GSC_VERIFICATION=""
# X/Twitter handle for twitter:site card (e.g. "@keyd"). Optional.
NEXT_PUBLIC_TWITTER_HANDLE=""

# --- Analytics (GA4) ---
# GA4 Measurement ID, e.g. "G-XXXXXXXXXX". Leave empty to fully disable analytics.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
# Set "true" to enable GA4 outside production (local debugging). Default: only in production.
NEXT_PUBLIC_ANALYTICS_ENABLED=""

# --- Deployment (Docker/Railway boot) ---
# The container runs `prisma migrate deploy` on boot automatically.
# Set SEED_ON_BOOT=true to also seed demo data (admin/seller/buyer test accounts) —
# it only seeds when the database is EMPTY, so it never wipes real data. Unset after
# the first successful seeded deploy.
SEED_ON_BOOT=""

# --- Background worker ---
# When "true", the Next.js process auto-runs the in-process job poller (single-command dev).
# Set "false" and run `npm run worker` separately to emulate a dedicated worker.
WORKER_IN_PROCESS="true"
WORKER_POLL_MS="1500"
